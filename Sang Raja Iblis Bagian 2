int main() {
    int a;
    int b;
    scanf("%d", &a);
    scanf("%d", &b);
    
    if (a + b > a - b && a + b > a * b) {
        printf("+");
    } else if (a - b > a + b && a - b > a * b) {
        printf("-");
    } else if (a * b > a - b && a * b > a + b) {
        printf("*");
    }
    return 0;
}
